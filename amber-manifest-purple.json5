{
  manifest_version: "0.1.0",
  program: {
    image: "tenalirama2026/pi-bench-agentx:v48",
    entrypoint: ["/app/start.sh"],
    env: {
      AZURE_OPENAI_KEY: "9o1gvQfJSN4mxG3PZxkCNyBPy7tbBwVHU91J8WWTxsXDyitVXsgXJQQJ99CEACHYHv6XJ3w3AAAAACOGi4Jf",
      AZURE_OPENAI_ENDPOINT: "https://pi-bench-agentx-resource.cognitiveservices.azure.com/",
      PORT: "9019",
    },
    network: {
      endpoints: [
        { name: "a2a", port: 9019 },
      ],
    },
  },
  config_schema: {
    type: "object",
     properties: {}
      
    },    
    required: [],
    additionalProperties: false,
  },
  provides: {
    a2a: { kind: "a2a", endpoint: "a2a" },
  },
  exports: {
    a2a: "a2a",
  },
  metadata: {
    assessment_config: {
      domain: "all",
    },
    participant_roles: ["agent"],
  },
}
