{
  manifest_version: "0.1.0",
  program: {
    image: "tenalirama2026/pi-bench-agentx:v49",
    entrypoint: ["/app/start.sh"],
    env: {
      AZURE_OPENAI_KEY: "${config.azure_openai_key}",
      AZURE_OPENAI_ENDPOINT: "https://pi-bench-agentx-resource.cognitiveservices.azure.com/",
      PORT: "9019",
    },
    network: {
      endpoints: [
        { name: "a2a", port: 9019 },
      ],
    },
  },
  config_schema: {
    type: "object",
     properties: {azure_openai_key: { type: "string", secret: true },
      
    },    
    required: ["azure_openai_key"],
    additionalProperties: false,
  },
  provides: {
    a2a: { kind: "a2a", endpoint: "a2a" },
  },
  exports: {
    a2a: "a2a",
  },
  metadata: {
    assessment_config: {
      domain: "all",
    },
    participant_roles: ["agent"],
  },
}
